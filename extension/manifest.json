{
  "manifest_version": 3,
  "name": "TabMind",
  "version": "0.1.0",
  "description": "Send tabs to your TabMind library — link + full snapshot — then close them without fear.",
  "permissions": ["tabs", "pageCapture", "scripting", "contextMenus", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TabMind",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "save-tab": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Save current tab to TabMind" },
    "save-close-tab": { "suggested_key": { "default": "Alt+Shift+X" }, "description": "Save current tab to TabMind and close it" }
  }
}
